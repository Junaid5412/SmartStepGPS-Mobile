<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules. Paired with android:allowBackup="false" in the manifest.

  Without these, the platform default is to back up app data - which on this app means the
  SharedPreferences holding the signed-in user's details, and on older devices could be pulled off
  with "adb backup". The API token itself lives in flutter_secure_storage (Keystore-backed) and was
  never in the backup set, but the rest of the profile data was.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
