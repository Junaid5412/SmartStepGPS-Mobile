<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 (API 31) and above.
     From API 31 the platform draws the splash itself through the SplashScreen API and IGNORES
     android:windowBackground, so the layer-list in drawable/launch_background.xml never appears on
     a modern phone. Without these attributes Android falls back to the launcher icon on the
     default system background, which is why the splash still looked untouched. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <!-- The FULL logo (drawable/splash_icon.xml), sized to fit Android 12's 160 dp circle - the same
             picture, at the same size, as the app's own splash (lib/screens/splash_screen.dart). The launcher
             monogram used before made a cold start look like two splashes: monogram, then the full logo. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- The splash colour, not the theme's background: between the system splash and the app's first
             frame the window shows this, and anything else is a visible flash (black in dark mode). -->
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
